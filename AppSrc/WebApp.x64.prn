37893>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37896>>>        Case Begin
37896>>>            Case (NavigateData.eNavigateType = nfFromMain)
37898>>>                // If from main, this is a propbably a main file Select to Zoom.
37898>>>                Case Break
37899>>>
37899>>>            Case (NavigateData.eNavigateType = nfFromParent)
37902>>>                // If from parent, this is a constrained drill down.
37902>>>                Case Break
37903>>>
37903>>>            Case (NavigateData.eNavigateType = nfFromChild)
37906>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37906>>>                Case Break
37907>>>
37907>>>            Case Else // must be nfUndefined
37907>>>
37907>>>        Case End
37907>>>
37907>>>        Send SetActionButtons
37908>>>
37908>>>    End_Procedure
37909>>>
37909>>>End_Object 
