37871>>>
37871>>>        // let's hide all buttons and then Show the ones we want
37871>>>        WebSet pbRender of oEditBtn to False
37872>>>        WebSet pbRender of oSaveBtn to False
37873>>>        WebSet pbRender of oCancelChangesBtn to False
37874>>>        WebSet pbRender of oDeleteBtn to False
37875>>>
37875>>>        If (NavigateData.bReadOnly) Begin
37877>>>            WebSet pbRender of oEditBtn to True
37878>>>        End
37878>>>>
37878>>>        Else Begin
37879>>>            WebSet pbRender of oSaveBtn to True
37880>>>            WebSet pbRender of oCancelChangesBtn to True
37881>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37882>>>        End
37882>>>>
37882>>>    End_Procedure
