37906>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37906>>>                Case Break
37907>>>
37907>>>            Case Else // must be nfUndefined
37907>>>
37907>>>        Case End
37907>>>
37907>>>        Send SetActionButtons
